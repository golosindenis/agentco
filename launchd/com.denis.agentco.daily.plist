<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.denis.agentco.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/denisgolosin/agentco/scripts/daily.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- StartCalendarInterval only catches up after sleep, never after the Mac
       was powered off at 7:00 — which is how Sep 9-13 2026 were all missed.
       RunAtLoad runs it again at boot/login; schedule.ts skips anything
       already queued today, so a second run the same day is a no-op. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/denisgolosin/agentco/logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/denisgolosin/agentco/logs/launchd.err.log</string>
</dict>
</plist>

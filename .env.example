# Used by the CLI (src/db.ts) and the worker. Full read/write access,
# bypasses Row Level Security — this is the "god mode" key. Never expose it
# to a browser, never commit it, never put it in a NEXT_PUBLIC_* variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Used by the web app (web/middleware.ts, web/app/lib/supabaseServer.ts) for
# the signed-in auth client only — never for reading operations data, see
# web/app/lib/supabaseServer.ts. These two are safe to expose to the
# browser: the anon key is public by design (Supabase's Row Level Security,
# not secrecy, is what's supposed to protect the data behind it — this repo
# instead denies anon/authenticated entirely and gates access at the app
# layer, see supabase/migrations/0001_init.sql), and NEXT_PUBLIC_* variables
# are bundled into client JS by Next.js regardless. Same project as above;
# find these values under Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# The one email address allowed to sign in to the web app (web/middleware.ts,
# web/app/lib/supabaseServer.ts). This project has open Supabase signup, so
# this allowlist check — not the existence of a session — is what actually
# gates access. Unset, every sign-in attempt fails closed (safe, but shows
# up as a confusing redirect loop back to /login rather than a clear error).
ALLOWED_EMAIL=you@example.com
